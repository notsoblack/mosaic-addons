{
  "name": "hoodstreet-passport",
  "version": "0.4.1",
  "description": "HoodStreet / CCFF00 member passport addon for MosAIc Companion — read-only audit (Create/Mint/Transfer shipped as v0.2.x source; see CHANGELOG.md)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-noncustodial.cjs && vite build",
    "build:contract": "node scripts/compile-contract.cjs",
    "check:noncustodial": "node scripts/check-noncustodial.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder'",
    "clean": "rm -rf renderer dist .vite .solc-input.json .solc-output.json"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "solc": "0.8.28",
    "tailwindcss": "3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
